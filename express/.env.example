# Copy this file to .env and adjust if needed.

# PostgreSQL from `docker compose up -d` (see docker-compose.yml)
DATABASE_URL="postgresql://stockwatch:stockwatch@localhost:5433/stockwatch?schema=public"
# Separate database that `npm test` migrates and wipes between tests
TEST_DATABASE_URL="postgresql://stockwatch:stockwatch@localhost:5433/stockwatch_test?schema=public"
# Set to 1 only if you use `npx prisma dev` instead of Docker (see README). Leave empty otherwise.
DATABASE_POOL_MAX=

PORT=3000

# Better Auth. Make the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-a-generated-secret"
# The API's public URL; browsers on this origin are trusted automatically.
BETTER_AUTH_URL="http://localhost:3000"
# Other sites allowed to sign in, comma-separated. Leave empty locally (the Vite dev
# server is always trusted). When deploying, set it to the frontend's URL.
BETTER_AUTH_TRUSTED_ORIGINS=

# Demo login account created by `npm run db:seed` (the seed fails without a password).
DEMO_USER_EMAIL="demo-login@example.com"
DEMO_USER_PASSWORD="change-this-demo-password"

# Free key from https://finnhub.io for live prices and the ticker check on new
# watches. If not set, the poller and the ticker check are skipped. Tests ignore it.
FINNHUB_API_KEY=

# SMTP for alert emails. If not set, emails are skipped (alerts still reach the
# live stream at /api/alerts/stream).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ALLOW_INVALID_CERT=false
ALERT_EMAIL_FROM=

# DigitalOcean Spaces, for a copy of each user's portfolio (saved on every portfolio
# download and import). If the bucket or keys aren't set, nothing is saved and the
# portfolio routes still work. Tests ignore these.
DO_SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
DO_SPACES_REGION=tor1
DO_SPACES_BUCKET=
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=